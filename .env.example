# Example only. Set these through the hosting environment / secret manager.
# dotnet run does not automatically load this file. No real credentials belong here.
ASPNETCORE_ENVIRONMENT=Development
Product__CommercialMode=true
Product__MarketDataApproved=false
Product__PublicOrigin=http://localhost:5080
Product__DatabasePath=data/product.db
Product__DataProtectionKeysPath=data/keys

Product__Limits__FreeOverviewMarkets=3
Product__Limits__FreeWatchlist=5
Product__Limits__ProWatchlist=100
Product__Limits__ProAlertRules=20
Product__Limits__AlertHistoryDays=90

# Configure actual test-only Stripe credentials and an active USD 2900/month price.
# Live keys/events are rejected by this release. Production charging is disabled in code.
Product__Billing__Enabled=false
Product__Billing__SecretKey=
Product__Billing__WebhookSecret=
Product__Billing__PriceId=

# Verified transactional mail provider SMTP credentials, server only.
Product__Mail__Host=
Product__Mail__Port=587
Product__Mail__Username=
Product__Mail__Password=
Product__Mail__From=
Product__Mail__EnableSsl=true

# Generate your own P-256 VAPID pair. Only PublicKey is sent to the browser.
Product__Push__Enabled=false
Product__Push__PublicKey=
Product__Push__PrivateKey=
Product__Push__Subject=
Product__Push__MaximumDevices=5
Product__Push__AlertExpirySeconds=300
Product__Push__MaximumAttempts=4
Product__Push__PollSeconds=5
Product__Push__ObservationWindowMinutes=120

# Shared exchange adapter; public spot/USD listings, no customer trading credentials.
MarketData__Provider=kraken
MarketData__QuoteCurrency=USD
Kraken__CountryCode=
Kraken__Region=
Kraken__TradingVenue=Public spot market listings

# Shared engine estimates only. Customers save their own fee/slippage assumptions.
Signals__Scanner__Execution__FeeBps=40
Signals__Scanner__Execution__SlippageBps=10

# Optional original market-engine history storage, separate from product/customer SQLite.
ConnectionStrings__Postgres=
