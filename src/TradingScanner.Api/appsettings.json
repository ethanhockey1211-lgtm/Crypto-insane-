{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Urls": "http://0.0.0.0:5080",
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "MarketData": {
    "Provider": "kraken",
    "QuoteCurrency": "USD",
    "UniverseSize": 200,
    "MinVolume24hQuote": 1000000,
    "SymbolsPerConnection": 60,
    "CandleCloseGrace": "00:00:02",
    "StaleQuoteThreshold": "00:00:30",
    "ReceiveTimeout": "00:00:15",
    "ReconnectInitialDelay": "00:00:01",
    "ReconnectMaxDelay": "00:00:30",
    "IngestChannelCapacity": 100000,
    "WarmUpHistory": true,
    "WarmUpRequestsPerSecond": 2
  },
  "Analytics": {
    "Structure": { "SwingStrength": 3, "LevelToleranceAtr": 0.35, "RangeLookback": 48 }
  },
  "Signals": {
    "Breakout": { "Timeframe": "M5", "RelVolConfirm": 1.5, "MinCloseStrength": 0.6, "ExtendedAtr": 2.0 },
    "Scanner": {
      "IntervalMs": 1000,
      "TopN": 50,
      "SetupScoreThreshold": 60,
      "Execution": { "MinScore": 60, "FeeBps": 0, "SlippageBps": 5 }
    }
  },
  "Coinbase": {
    "WebSocketUrl": "wss://ws-feed.exchange.coinbase.com",
    "RestUrl": "https://api.exchange.coinbase.com"
  },
  "Kraken": {
    "WebSocketUrl": "wss://ws.kraken.com/v2",
    "RestUrl": "https://api.kraken.com",
    "CountryCode": ""
  }
}
